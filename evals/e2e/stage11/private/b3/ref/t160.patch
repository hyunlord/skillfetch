diff --git a/Makefile b/Makefile
index 7081890..14a71be 100644
--- a/Makefile
+++ b/Makefile
@@ -2,9 +2,10 @@ MODULE   := github.com/acme-fleet/tracker
 VERSION  ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
 REGISTRY ?= ghcr.io/acme-fleet
 API_IMAGE := $(REGISTRY)/tracker-api
+INGEST_IMAGE := $(REGISTRY)/tracker-ingest
 LDFLAGS  := -s -w -X $(MODULE)/internal/version.Version=$(VERSION)
 
-.PHONY: all build test vet image-api push-api release clean
+.PHONY: all build test vet image-api push-api push-ingest release clean
 
 all: build
 
@@ -23,9 +24,13 @@ image-api:
 push-api: image-api
 	docker push $(API_IMAGE):$(VERSION)
 
+# ko builds and pushes the image itself (no Dockerfile); ldflags come from .ko.yaml.
+push-ingest:
+	VERSION=$(VERSION) KO_DOCKER_REPO=$(INGEST_IMAGE) ko build --bare --tags $(VERSION) ./cmd/tracker-ingest
+
 # Run from CI on a tag (see README "Releasing"). Needs registry credentials.
-release: vet test push-api
-	@echo "released $(VERSION): $(API_IMAGE):$(VERSION)"
+release: vet test push-api push-ingest
+	@echo "released $(VERSION): $(API_IMAGE):$(VERSION) $(INGEST_IMAGE):$(VERSION)"
 
 clean:
 	rm -rf bin dist
