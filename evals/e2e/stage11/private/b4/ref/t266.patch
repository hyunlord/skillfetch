diff --git a/tests/media_concurrency.rs b/tests/media_concurrency.rs
new file mode 100644
index 0000000..35ed91c
--- /dev/null
+++ b/tests/media_concurrency.rs
@@ -0,0 +1,51 @@
+use std::io::Cursor;
+
+use axum::{
+    body::Body,
+    http::{Request, StatusCode},
+};
+use cms_api::{app, AppState, Config};
+use image::{ImageFormat, RgbImage};
+use tower::ServiceExt;
+
+fn png(w: u32, h: u32) -> Vec<u8> {
+    let img = RgbImage::from_fn(w, h, |x, y| {
+        image::Rgb([(x % 256) as u8, (y % 256) as u8, 7])
+    });
+    let mut buf = Vec::new();
+    img.write_to(&mut Cursor::new(&mut buf), ImageFormat::Png)
+        .unwrap();
+    buf
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn burst_of_resizes_all_succeed_with_a_small_limit() {
+    let config = Config {
+        max_concurrent_resizes: 2,
+        ..Config::default()
+    };
+    let router = app(AppState::new(config));
+    let img = png(600, 400);
+    let mut jobs = Vec::new();
+    for _ in 0..12 {
+        let (r, body) = (router.clone(), img.clone());
+        jobs.push(tokio::spawn(async move {
+            r.oneshot(
+                Request::post("/api/media/resize?w=120&h=120")
+                    .body(Body::from(body))
+                    .unwrap(),
+            )
+            .await
+            .unwrap()
+            .status()
+        }));
+    }
+    for j in jobs {
+        assert_eq!(j.await.unwrap(), StatusCode::OK);
+    }
+}
+
+#[test]
+fn default_limit_is_positive() {
+    assert!(Config::default().max_concurrent_resizes >= 1);
+}
