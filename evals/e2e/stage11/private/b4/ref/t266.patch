@@ -41,8 +41,19 @@ async fn resize(
     if body.len() > state.config.max_upload_bytes {
         return StatusCode::PAYLOAD_TOO_LARGE.into_response();
     }
-    match resize_to_fit(&body, p.w, p.h) {
-        Ok(png) => ([(header::CONTENT_TYPE, "image/png")], png).into_response(),
-        Err(e) => (StatusCode::BAD_REQUEST, e.to_string()).into_response(),
+    // Wait (asynchronously) for a resize slot, then run the CPU-bound work on the blocking pool so the async
+    // workers keep serving the other endpoints. The permit moves into the blocking task and is released when it ends.
+    let permit = match state.resize_permits.clone().acquire_owned().await {
+        Ok(p) => p,
+        Err(_) => return StatusCode::SERVICE_UNAVAILABLE.into_response(),
+    };
+    let job = tokio::task::spawn_blocking(move || {
+        let _permit = permit;
+        resize_to_fit(&body, p.w, p.h)
+    });
+    match job.await {
+        Ok(Ok(png)) => ([(header::CONTENT_TYPE, "image/png")], png).into_response(),
+        Ok(Err(e)) => (StatusCode::BAD_REQUEST, e.to_string()).into_response(),
+        Err(_) => (StatusCode::INTERNAL_SERVER_ERROR, "resize task failed").into_response(),
     }
 }
