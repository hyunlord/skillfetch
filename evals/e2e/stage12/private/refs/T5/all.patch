+def calculate_total_v2(
+    unit_price: float, quantity: int, discount_pct: float = 0.0, tenant: str = ""
+) -> float:
+    """Calculate with tiered discount behind feature flag."""
+    use_new = is_on("orders.new_discount", tenant)
+    nwlog_event("pricing.discount_evaluated", tenant_id=tenant, trace_id="", flag_value=use_new)
+    if use_new:
+        tiers = [(10, 5), (50, 10), (100, 15)]
+        for threshold, pct in reversed(tiers):
+            if quantity >= threshold:
+                discount_pct = max(discount_pct, pct)
+                break
+    return calculate_total(unit_price, quantity, discount_pct)
+
+
 def apply_tax(amount: float, tax_rate: float = 0.1) -> float:
     """Apply tax rate to amount."""
     return round(amount * (1 + tax_rate), 2)
