     if not row:
         raise HTTPException(status_code=404, detail="Order not found")
     return dict(row)
+
+
+@router.get("/orders")
+def list_orders(
+    status: str | None = None,
+    cursor: str | None = None,
+    limit: int = Query(default=20, le=100),
+):
+    db = get_db()
+    if cursor:
+        if status:
+            rows = db.execute("SELECT * FROM orders WHERE id > ? AND status = ? ORDER BY id LIMIT ?", (int(cursor), status, limit)).fetchall()
+        else:
+            rows = db.execute("SELECT * FROM orders WHERE id > ? ORDER BY id LIMIT ?", (int(cursor), limit)).fetchall()
+    else:
+        if status:
+            rows = db.execute("SELECT * FROM orders WHERE status = ? ORDER BY id LIMIT ?", (status, limit)).fetchall()
+        else:
+            rows = db.execute("SELECT * FROM orders ORDER BY id LIMIT ?", (limit,)).fetchall()
+    db.close()
+    def fmt(r):
+        d = dict(r)
+        for k in ("created_at", "updated_at"):
+            if k in d and isinstance(d[k], str) and not d[k].endswith("Z"):
+                d[k] = d[k] + "Z" if "T" in d[k] else d[k]
+        return d
+    items = [fmt(r) for r in rows]
+    next_cursor = str(rows[-1]["id"]) if len(rows) == limit else None
+    return {"data": items, "next_cursor": next_cursor}
