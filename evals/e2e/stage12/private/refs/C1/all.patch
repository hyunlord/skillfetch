diff --git a/orders/customer_routes.py b/orders/customer_routes.py
new file mode 100644
index 0000000..7aaa548
--- /dev/null
+++ b/orders/customer_routes.py
@@ -0,0 +1,42 @@
+"""Customer API routes."""
+from uuid import uuid4
+
+from fastapi import APIRouter
+from fastapi.responses import JSONResponse
+
+from lib.nwlog import event as nwlog_event
+from orders.database import get_db
+
+router = APIRouter()
+
+
+@router.get("/customers/{customer_id}")
+def get_customer(customer_id: str):
+    trace_id = str(uuid4())
+    db = get_db()
+    try:
+        row = db.execute(
+            "SELECT * FROM customers WHERE public_id = ?", (customer_id,)
+        ).fetchone()
+        if not row:
+            nwlog_event("customers.not_found", tenant_id="", trace_id=trace_id, customer_id=customer_id)
+            return JSONResponse(
+                status_code=404,
+                content={
+                    "error": {
+                        "code": "NW-CUST-001",
+                        "message": "Customer not found",
+                        "trace_id": trace_id,
+                    }
+                },
+            )
+        nwlog_event("customers.retrieved", tenant_id="", trace_id=trace_id, customer_id=customer_id)
+        return {
+            "id": row["public_id"],
+            "name": row["name"],
+            "email": row["email"],
+            "joined_at": row["joined_at"],
+            "updated_at": row["updated_at"],
+        }
+    finally:
+        db.close()
