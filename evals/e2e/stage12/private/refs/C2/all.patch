+import Layout from '../components/Layout'
+import { t } from '../lib/i18n'
+import { useState } from 'react'
+
+export default function SettingsPage() {
+  const [language, setLanguage] = useState('en')
+  const [notifications, setNotifications] = useState(true)
+
+  return (
+    <Layout title={t('settings.page_title')}>
+      <h1 style={{
+        color: 'var(--nw-color-text)',
+        marginBottom: 'var(--nw-spacing-lg)',
+        fontSize: 'var(--nw-font-size-lg)'
+      }}>
+        {t('settings.heading')}
+      </h1>
+      <div style={{ padding: 'var(--nw-spacing-md)' }}>
+        <label style={{ display: 'block', marginBottom: 'var(--nw-spacing-md)', color: 'var(--nw-color-text)' }}>
+          {t('settings.language_label')}
+          <select
+            value={language}
+            onChange={(e) => setLanguage(e.target.value)}
+            style={{ marginLeft: 'var(--nw-spacing-sm)', padding: 'var(--nw-spacing-xs)' }}
+          >
+            <option value="en">{t('settings.lang_en')}</option>
+            <option value="ko">{t('settings.lang_ko')}</option>
+          </select>
+        </label>
+        <label style={{ display: 'block', color: 'var(--nw-color-text)' }}>
+          <input
+            type="checkbox"
+            checked={notifications}
+            onChange={(e) => setNotifications(e.target.checked)}
+            style={{ marginRight: 'var(--nw-spacing-xs)' }}
+          />
+          {t('settings.notifications_label')}
+        </label>
+      </div>
+    </Layout>
+  )
+}
