diff --git a/pages/orders.tsx b/pages/orders.tsx
new file mode 100644
index 0000000..9cf0639
--- /dev/null
+++ b/pages/orders.tsx
@@ -0,0 +1,72 @@
+import Layout from '../components/Layout'
+import { t } from '../lib/i18n'
+import { track } from '../lib/analytics'
+import { fetchApi } from '../lib/api'
+import { useState } from 'react'
+
+export default function OrdersPage() {
+  const [orders] = useState<any[]>([])
+  const [showCancel, setShowCancel] = useState(false)
+  const [cancelTarget, setCancelTarget] = useState<string | null>(null)
+
+  const handleCancel = (orderId: string) => {
+    setCancelTarget(orderId)
+    setShowCancel(true)
+  }
+
+  const confirmCancel = async () => {
+    await fetchApi(`/orders/${cancelTarget}/cancel`, { method: 'POST' })
+    track('orders_cancel', { order_id: cancelTarget })
+    setShowCancel(false)
+    setCancelTarget(null)
+  }
+
+  return (
+    <Layout title={t('orders.page_title')}>
+      <h1 style={{
+        color: 'var(--nw-color-text)',
+        marginBottom: 'var(--nw-spacing-lg)',
+        fontSize: 'var(--nw-font-size-lg)'
+      }}>
+        {t('orders.heading')}
+      </h1>
+      <p style={{ color: 'var(--nw-color-text-secondary)', padding: 'var(--nw-spacing-md)' }}>
+        {t('orders.empty_state')}
+      </p>
+      <button
+        onClick={() => handleCancel('sample')}
+        style={{
+          backgroundColor: 'var(--nw-color-error)',
+          color: 'var(--nw-color-bg)',
+          padding: 'var(--nw-spacing-sm) var(--nw-spacing-md)',
+          borderRadius: 'var(--nw-radius-sm)',
+          border: 'none',
+          cursor: 'pointer'
+        }}
+      >
+        {t('orders.cancel_button')}
+      </button>
+      {showCancel && (
+        <div style={{
+          position: 'fixed', top: 0, left: 0, right: 0, bottom: 0,
+          backgroundColor: 'rgba(0,0,0,0.5)',
+          display: 'flex', alignItems: 'center', justifyContent: 'center'
+        }}>
+          <div style={{
+            backgroundColor: 'var(--nw-color-bg)',
+            padding: 'var(--nw-spacing-lg)',
+            borderRadius: 'var(--nw-radius-md)'
+          }}>
+            <p style={{ marginBottom: 'var(--nw-spacing-md)' }}>{t('orders.cancel_confirm')}</p>
+            <button onClick={confirmCancel} style={{ marginRight: 'var(--nw-spacing-sm)' }}>
+              {t('orders.cancel_yes')}
+            </button>
+            <button onClick={() => setShowCancel(false)}>
+              {t('orders.cancel_no')}
+            </button>
+          </div>
+        </div>
+      )}
+    </Layout>
+  )
+}
