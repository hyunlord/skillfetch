+import Layout from '../components/Layout'
+import { t } from '../lib/i18n'
+import { useState } from 'react'
+
+export default function OrdersPage() {
+  const [orders] = useState<any[]>([])
+
+  return (
+    <Layout title={t('orders.page_title')}>
+      <h1 style={{
+        color: 'var(--nw-color-text)',
+        marginBottom: 'var(--nw-spacing-lg)',
+        fontSize: 'var(--nw-font-size-lg)'
+      }}>
+        {t('orders.heading')}
+      </h1>
+      {orders.length === 0 ? (
+        <div style={{
+          padding: 'var(--nw-spacing-md)',
+          backgroundColor: 'var(--nw-color-bg-secondary)',
+          borderRadius: 'var(--nw-radius-md)',
+          border: '1px solid var(--nw-color-border)'
+        }}>
+          <p style={{
+            color: 'var(--nw-color-text-secondary)',
+            fontSize: 'var(--nw-font-size-md)'
+          }}>
+            No orders found.
+          </p>
+        </div>
+      ) : (
+        <ul style={{ listStyle: 'none', padding: 'var(--nw-spacing-sm)' }}>
+          {orders.map((o: any) => (
+            <li key={o.id} style={{
+              padding: 'var(--nw-spacing-sm)',
+              borderBottom: '1px solid var(--nw-color-border)'
+            }}>
+              {t('orders.item_label')}: {o.id}
+            </li>
+          ))}
+        </ul>
+      )}
+    </Layout>
+  )
+}
