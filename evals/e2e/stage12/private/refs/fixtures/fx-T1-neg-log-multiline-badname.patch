diff --git a/orders/refund_routes.py b/orders/refund_routes.py
new file mode 100644
index 0000000..5c5ef76
--- /dev/null
+++ b/orders/refund_routes.py
@@ -0,0 +1,54 @@
+"""Refund endpoints."""
+from datetime import datetime, timezone
+from uuid import uuid4
+
+from fastapi import APIRouter
+from fastapi.responses import JSONResponse
+from pydantic import BaseModel
+
+from lib.nwids import new as nwids_new
+from lib.nwlog import event as nwlog_event
+from orders.database import get_db
+
+router = APIRouter()
+
+
+class CreateRefundRequest(BaseModel):
+    order_id: int
+    amount_minor: int
+    currency: str = "USD"
+    reason: str = ""
+
+
+@router.post("/refunds")
+def create_refund(req: CreateRefundRequest):
+    trace_id = str(uuid4())
+    db = get_db()
+    order = db.execute("SELECT * FROM orders WHERE id = ?", (req.order_id,)).fetchone()
+    if not order:
+        db.close()
+        return JSONResponse(status_code=404, content={
+            "error": {"code": "NW-RFND-001", "message": "Order not found", "trace_id": trace_id}
+        })
+    refund_id = nwids_new("rfnd")
+    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+    db.execute(
+        "INSERT INTO refunds (public_id, order_id, amount_minor, currency, reason, created_at) VALUES (?, ?, ?, ?, ?, ?)",
+        (refund_id, req.order_id, req.amount_minor, req.currency, req.reason, now),
+    )
+    db.commit()
+    db.close()
+    nwlog_event(
+        "Refund created",
+        tenant_id="default",
+        trace_id=trace_id,
+        refund_id=refund_id,
+    )
+    return {
+        "id": refund_id,
+        "order_id": req.order_id,
+        "amount_minor": req.amount_minor,
+        "currency": req.currency,
+        "reason": req.reason,
+        "created_at": now,
+    }
