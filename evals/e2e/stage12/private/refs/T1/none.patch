+"""Refund endpoints."""
+from datetime import datetime
+
+from fastapi import APIRouter, HTTPException
+from pydantic import BaseModel
+
+from orders.database import get_db
+
+router = APIRouter()
+
+
+class CreateRefundRequest(BaseModel):
+    order_id: int
+    amount: float
+    reason: str = ""
+
+
+@router.post("/refunds")
+def create_refund(req: CreateRefundRequest):
+    db = get_db()
+    order = db.execute("SELECT * FROM orders WHERE id = ?", (req.order_id,)).fetchone()
+    if not order:
+        db.close()
+        raise HTTPException(status_code=404, detail="Order not found")
+    now = datetime.utcnow().isoformat()
+    db.execute(
+        "INSERT INTO refunds (order_id, amount, reason, created_at) VALUES (?, ?, ?, ?)",
+        (req.order_id, req.amount, req.reason, now),
+    )
+    db.commit()
+    print(f"Refund created for order {req.order_id}")
+    refund = db.execute("SELECT * FROM refunds ORDER BY id DESC LIMIT 1").fetchone()
+    db.close()
+    return dict(refund)
