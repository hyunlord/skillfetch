new file mode 100644
index 0000000..3daa8e1
--- /dev/null
+++ b/backend/tests/api/routes/test_items_owner_list.py
@@ -0,0 +1,26 @@
+from fastapi.testclient import TestClient
+from sqlmodel import Session
+
+from app import crud
+from app.core.config import settings
+from app.models import ItemCreate, UserUpdate
+from tests.utils.item import create_random_item
+from tests.utils.user import create_random_user, user_authentication_headers
+from tests.utils.utils import random_lower_string
+
+
+def test_normal_user_lists_only_own_items(client: TestClient, db: Session) -> None:
+    password = random_lower_string()
+    user = create_random_user(db)
+    crud.update_user(session=db, db_user=user, user_in=UserUpdate(password=password))
+    headers = user_authentication_headers(client=client, email=user.email, password=password)
+    own = {
+        str(crud.create_item(session=db, item_in=ItemCreate(title=f"own {i}"), owner_id=user.id).id)
+        for i in range(2)
+    }
+    create_random_item(db)  # owned by someone else
+    r = client.get(f"{settings.API_V1_STR}/items/", headers=headers)
+    assert r.status_code == 200
+    body = r.json()
+    assert {i["id"] for i in body["data"]} == own
+    assert body["count"] == 2
