@@ -0,0 +1,46 @@
+from datetime import UTC, datetime, timedelta
+
+import jwt
+from fastapi.testclient import TestClient
+from sqlmodel import Session
+
+from app import crud
+from app.core import security
+from app.core.config import settings
+from app.models import UserUpdate
+from tests.utils.user import create_random_user
+
+
+def _me(client: TestClient, token: str):
+    return client.get(f"{settings.API_V1_STR}/users/me", headers={"Authorization": f"Bearer {token}"})
+
+
+def _token(sub: str, minutes: int = 5, key: str = settings.SECRET_KEY) -> str:
+    exp = datetime.now(UTC) + timedelta(minutes=minutes)
+    return jwt.encode({"exp": exp, "sub": sub}, key, algorithm=security.ALGORITHM)
+
+
+def test_bad_signature(client: TestClient, db: Session) -> None:
+    user = create_random_user(db)
+    assert _me(client, _token(str(user.id), key="wrong-key")).status_code == 403
+
+
+def test_expired_token(client: TestClient, db: Session) -> None:
+    user = create_random_user(db)
+    assert _me(client, _token(str(user.id), minutes=-5)).status_code == 403
+
+
+def test_deleted_user(client: TestClient, db: Session) -> None:
+    user = create_random_user(db)
+    token = _token(str(user.id))
+    db.delete(user)
+    db.commit()
+    assert _me(client, token).status_code == 404
+
+
+def test_inactive_user(client: TestClient, db: Session) -> None:
+    user = create_random_user(db)
+    crud.update_user(session=db, db_user=user, user_in=UserUpdate(is_active=False))
+    r = _me(client, _token(str(user.id)))
+    assert r.status_code == 400
+    assert r.json()["detail"] == "Inactive user"
