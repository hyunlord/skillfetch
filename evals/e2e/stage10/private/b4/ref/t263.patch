 use l2::{OrderBook, PriceLevel};
 
 /// Highest bid (bids are sent best first).
-pub fn best_bid(book: &OrderBook) -> Option<&PriceLevel> {
+pub fn best_bid<'a>(book: &'a OrderBook<'_>) -> Option<&'a PriceLevel<'a>> {
