 }
 
 /// Lowest ask (asks are sent best first).
-pub fn best_ask(book: &OrderBook) -> Option<&PriceLevel> {
+pub fn best_ask<'a>(book: &'a OrderBook<'_>) -> Option<&'a PriceLevel<'a>> {
     book.asks.first()
