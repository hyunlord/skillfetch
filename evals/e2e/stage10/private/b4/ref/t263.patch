 /// Mid price of the top of book, if both sides are present.
-pub fn mid_price(book: &OrderBook) -> Option<f64> {
+pub fn mid_price(book: &OrderBook<'_>) -> Option<f64> {
     let bid: f64 = best_bid(book)?.price.parse().ok()?;
     let ask: f64 = best_ask(book)?.price.parse().ok()?;
     Some((bid + ask) / 2.0)
