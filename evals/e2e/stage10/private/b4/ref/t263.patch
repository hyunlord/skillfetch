-pub fn parse_order_book(input: &str) -> Result<OrderBook, ParseError> {
+pub fn parse_order_book(input: &str) -> Result<OrderBook<'_>, ParseError> {
     let mut parts = input.trim_end().split('|');
     let symbol = parts.next().filter(|s| !s.is_empty()).ok_or(ParseError::MissingSymbol)?;
     let bids = parse_side(parts.next(), 'B')?;
     let asks = parse_side(parts.next(), 'A')?;
-    Ok(OrderBook { symbol: symbol.to_string(), bids, asks })
+    Ok(OrderBook { symbol, bids, asks })
 }
 
-fn parse_side(part: Option<&str>, side: char) -> Result<Vec<PriceLevel>, ParseError> {
+fn parse_side(part: Option<&str>, side: char) -> Result<Vec<PriceLevel<'_>>, ParseError> {
     let body = part
         .and_then(|p| p.strip_prefix(side))
         .and_then(|p| p.strip_prefix(':'))
         .ok_or(ParseError::MissingSide(side))?;
-    let mut levels = Vec::new();
+    let mut levels = Vec::with_capacity(body.bytes().filter(|&b| b == b',').count() + 1);
     for raw in body.split(',').filter(|s| !s.is_empty()) {
         let (price, size) = raw.split_once('x').ok_or_else(|| ParseError::BadLevel(raw.to_string()))?;
         if price.is_empty() || size.is_empty() {
             return Err(ParseError::BadLevel(raw.to_string()));
         }
-        levels.push(PriceLevel { price: price.to_string(), size: size.to_string() });
+        levels.push(PriceLevel { price, size });
     }
     Ok(levels)
 }
