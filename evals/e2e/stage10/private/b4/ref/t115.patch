     for (ch, slot) in out.iter_mut().enumerate() {
+        // SAFETY: `ch` comes from enumerating `out`, which has `CHANNELS` slots like `regs.data`, and the indexing
+        // `regs.data[ch]` is bounds-checked; the reference is aligned and valid for a read.
         *slot = unsafe { ptr::read_volatile(&regs.data[ch]) } as u16;
     }
 }
