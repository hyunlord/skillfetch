+    // SAFETY: `ch < CHANNELS` is asserted above, so `add(ch)` stays inside `regs.data`; the pointer comes from a
+    // live reference, so it is aligned and valid for a read.
     unsafe { ptr::read_volatile(regs.data.as_ptr().add(ch)) as u16 }
