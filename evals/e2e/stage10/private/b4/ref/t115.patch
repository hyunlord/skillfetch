+        // SAFETY: alignment and length are asserted above; every byte is initialized and any bit pattern is a valid
+        // `u32`; the slice borrows `self`.
         unsafe { slice::from_raw_parts(self.data.as_ptr() as *const u32, self.data.len() / 4) }
