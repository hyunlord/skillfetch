diff --git a/tests/test_reconcile.py b/tests/test_reconcile.py
index 711de4b..e0c554c 100644
--- a/tests/test_reconcile.py
+++ b/tests/test_reconcile.py
@@ -117,3 +117,38 @@ def test_main_missing_db(tmp_path, settlements_csv, capsys):
     assert rc == 2
     assert "ledger database not found" in capsys.readouterr().err
     assert not (tmp_path / "nope.db").exists()
+
+
+def test_main_dry_run_prints_diff_and_writes_nothing(ledger_db, settlements_csv, capsys):
+    before = ledger_db.read_bytes()
+    rc = rp.main(["--settlements", str(settlements_csv), "--db", str(ledger_db), "--dry-run"])
+    assert rc == 0
+    assert ledger_db.read_bytes() == before
+
+    out = capsys.readouterr().out
+    assert "+ po_2  amount_mismatch" in out
+    assert "expected=25.50  settled=25.00  delta=-0.50" in out
+    assert "po_3" in out and "missing_from_settlement" in out
+    assert "po_9" in out and "unknown_payout" in out
+    assert "would write 3 adjustment(s), nothing written" in out
+
+
+def test_main_dry_run_on_ledger_without_adjustments_table(tmp_path, settlements_csv, capsys):
+    db = tmp_path / "old.db"
+    conn = sqlite3.connect(db)
+    conn.execute(ledger.PAYOUTS_DDL)
+    conn.execute("INSERT INTO payouts VALUES ('po_1', 'm_a', 10000, 'USD', 'paid', 'x')")
+    conn.commit()
+    conn.close()
+    before = db.read_bytes()
+
+    assert rp.main(["--settlements", str(settlements_csv), "--db", str(db), "--dry-run"]) == 0
+    assert db.read_bytes() == before
+    assert "would write 2 adjustment(s)" in capsys.readouterr().out
+
+
+def test_format_cents():
+    assert rp.format_cents(128450) == "1284.50"
+    assert rp.format_cents(-1250) == "-12.50"
+    assert rp.format_cents(-5) == "-0.05"
+    assert rp.format_cents(0) == "0.00"
