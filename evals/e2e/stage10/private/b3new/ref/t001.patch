 """
 
 from __future__ import annotations
@@ -119,6 +123,22 @@ def write_adjustments(
     return len(adjustments)
 
 
+def format_cents(cents: int) -> str:
+    sign = "-" if cents < 0 else ""
+    return f"{sign}{abs(cents) // 100}.{abs(cents) % 100:02d}"
+
+
+def format_diff(adjustments: list[Adjustment]) -> str:
+    """Render the rows that would be added to payout_adjustments, diff style."""
+    lines = ["--- payout_adjustments", "+++ payout_adjustments (after reconciliation)"]
+    for a in adjustments:
+        lines.append(
+            f"+ {a.payout_id}  {a.reason:<24}  expected={format_cents(a.expected_cents)}"
+            f"  settled={format_cents(a.settled_cents)}  delta={format_cents(a.delta_cents)}"
+        )
+    return "\n".join(lines)
+
+
 def build_parser() -> argparse.ArgumentParser:
