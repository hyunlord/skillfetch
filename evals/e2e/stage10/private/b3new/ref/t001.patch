@@ -37,10 +37,16 @@ CREATE TABLE IF NOT EXISTS payout_adjustments (
 AdjustmentRow = tuple[str, int, int, int, str, str]
 
 
-def connect(path: str | Path) -> sqlite3.Connection:
-    """Open the ledger database. The file must already exist."""
+def connect(path: str | Path, *, readonly: bool = False) -> sqlite3.Connection:
+    """Open the ledger database. The file must already exist.
+
+    With ``readonly=True`` the file is opened with SQLite's ``mode=ro`` so no
+    statement can modify it.
+    """
     if not Path(path).is_file():
         raise FileNotFoundError(f"ledger database not found: {path}")
+    if readonly:
+        return sqlite3.connect(f"{Path(path).resolve().as_uri()}?mode=ro", uri=True)
     return sqlite3.connect(path)
 
 
