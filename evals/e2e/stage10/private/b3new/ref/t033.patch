diff --git a/tests/sanitizeHtml.test.ts b/tests/sanitizeHtml.test.ts
index 0adad00..d9a5059 100644
--- a/tests/sanitizeHtml.test.ts
+++ b/tests/sanitizeHtml.test.ts
@@ -72,6 +72,27 @@ describe('links', () => {
     expect(sanitizeHtml('<a href="vbscript:msgbox(1)">v</a>')).toBe('v');
   });
 
+  it('unwraps Google Docs redirect links to the real URL', () => {
+    const wrapped =
+      'https://www.google.com/url?q=https%3A%2F%2Fexample.com%2Fdocs%3Fa%3D1%26b%3D2&amp;sa=D&amp;source=editors';
+    expect(sanitizeHtml(`<a href="${wrapped}">docs</a>`)).toBe(
+      '<a href="https://example.com/docs?a=1&amp;b=2">docs</a>',
+    );
+    expect(sanitizeHtml('<a href="https://google.com/url?q=/pricing&sa=D">p</a>')).toBe(
+      '<a href="/pricing">p</a>',
+    );
+  });
+
+  it('still applies the allowlist to unwrapped redirect targets', () => {
+    expect(sanitizeHtml('<a href="https://www.google.com/url?q=javascript%3Aalert(1)&sa=D">x</a>')).toBe('x');
+    expect(sanitizeHtml('<a href="https://www.google.com/url?sa=D">x</a>')).toBe('x');
+  });
+
+  it('only unwraps google.com redirects', () => {
+    const html = '<a href="https://example.com/url?q=https://evil.test">y</a>';
+    expect(sanitizeHtml(html)).toBe(html);
+  });
+
   it('drops anchors without an href', () => {
     expect(sanitizeHtml('<a name="top">top</a>')).toBe('top');
